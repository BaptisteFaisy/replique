# image/buildfile — image invitée QNX 8.0 (x86_64) pour la démo Déclic.
#
# Construite avec le SDP 8.0 :
#   export QNX_HOST=$SDP/host/linux/x86_64
#   export QNX_TARGET=$SDP/target/qnx
#   mkifs -v -o . <buildfile rendu> replique.ifs
#
# Contenu : le noyau (procnto), un shell sur la console série, les outils
# QNX utiles à l'analyse (pidin, slog2info, tracelogger, dumper) et les
# binaires du projet : Déclic + les trois générateurs de bogues.
#
# La liste de recherche (search) commence par le répertoire courant : les
# binaires du projet doivent y avoir été copiés (voir image/README.md).

# Racine de recherche : le repertoire courant (binaires du projet) puis la
# racine de la cible QNX (les entrees du fichier sont relatives a ces racines).
[search=.:$QNX_TARGET/x86_64:$QNX_TARGET/x86_64/boot/sys:]

[+dupignore]
[+optional]

[uid=0 gid=0 dperms=0555 perms=0555]

[image=20m]
[virtual=x86_64,multiboot ] boot = {
    startup-x86 -D8250..115200 -zz -f 0,0,1000M
    PATH=/proc/boot:/system/bin
    LD_LIBRARY_PATH=/proc/boot:/system/lib:/system/lib/dll
    [+keeplinked uid=0 gid=0 perms=0700 ] CONFIG_PATH=/proc/boot:/system/etc procnto-smp-instr -mr -d 022 -u 066 -F 2000
}

# ------------------------------------------------------------------ démarrage
[+script] startup-script = {
    procmgr_symlink /proc/boot/ksh /bin/sh
    procmgr_symlink /proc/boot/ksh /bin/ksh
    procmgr_symlink /var/tmp /tmp
    procmgr_symlink /proc/boot/ldqnx-64.so.2 /usr/lib/ldqnx-64.so.2
    procmgr_symlink /proc/boot/slog2info /bin/slog2
    procmgr_symlink /proc/boot/pidin /bin/pidin
    procmgr_symlink /proc/boot/tracelogger /bin/tracelogger
    procmgr_symlink /proc/boot/dumper /bin/dumper
    PATH=/proc/boot:/system/bin
    LD_LIBRARY_PATH=/proc/boot:/system/lib:/system/lib/dll
    HOME=/proc/boot
    TERM=qansi
    # Pilotes de peripheriques : sans eux, ni la console VGA ni le port
    # serie n'existent (constate au premier boot : l'IFS s'arretait sur
    # « QNX v1.2d Boot Loader »).
    devc-con -n
    devc-ser8250 -e 115200
    waitfor /dev/ser1
    # Pilote de disque + modules de systeme de fichiers : sans eux, procnto
    # ne peut pas monter la racine et le boot s'arrete aussitot (constate au
    # deuxieme boot : l'IFS demarrait mais ne rendait pas la main).
    devb-eide cam user=20:20 blk cache=64M,auto=partition,vnode=2000,ncache=2000,commit=low
    waitfor /dev/hd0
    display_msg "Replique - invite QNX 8.0 (demo Declic)"
    # Le dumper ecrit les core dumps dans /var/dumper/cores (essai E5).
    dumper -U 30:30 -d /var/dumper -M 1000 -D cores
    # Shell sur la console serie : c'est par la que la demo se pilote.
    on -d -t /dev/ser1 -e HOME=/proc/boot ksh -l
}

# ------------------------------------------------------------------- fichiers
# Le chargeur multiboot est exige par la section [virtual=x86_64,multiboot].
multiboot.boot = boot/sys/multiboot.boot
procnto-smp-instr = boot/sys/procnto-smp-instr
startup-x86 = boot/sys/startup-x86

devc-con = sbin/devc-con
devc-ser8250 = sbin/devc-ser8250
devb-eide = sbin/devb-eide
io-blk.so = lib/dll/io-blk.so
fs-qnx6.so = lib/dll/fs-qnx6.so
on = bin/on
sh = bin/sh
ksh = bin/ksh
pidin = bin/pidin
slog2info = bin/slog2info
tracelogger = usr/sbin/tracelogger
dumper = usr/sbin/dumper

ldqnx-64.so.2 = usr/lib/ldqnx-64.so.2
libc.so.6 = lib/libc.so.6

# Binaires du projet (copies dans le repertoire du buildfile).
declic = ./declic
bug-deadlock = ./bug-deadlock
bug-prio-inversion = ./bug-prio-inversion
bug-race = ./bug-race
